  <rdf:Description rdf:about="" xmlns:crs="http://ns.adobe.com/camera-raw-settings/1.0/"
   crs:Temperature="5350" crs:Tint="+14" crs:Exposure2012="+0.20" crs:Shadows2012="+10">
   <crs:MaskGroupBasedCorrections>
    <rdf:Seq>
     <rdf:li>
      <rdf:Description crs:What="Correction" crs:CorrectionAmount="1" crs:CorrectionActive="true"
       crs:CorrectionName="Mask 1" crs:LocalExposure2012="0.15" crs:LocalShadows2012="0.3"
       crs:LocalSaturation="-0.04" crs:LocalCurveRefineSaturation="100">
       <crs:CorrectionMasks><rdf:Seq>
